# Variables de entorno de ejemplo (NO poner secretos reales aquí)
# Configura los secretos reales en GitHub Environments:
# Settings → Environments → {development|certification|production} → Secrets

# development
DEV_DEPLOY_TOKEN=
DEV_API_URL=https://dev.example.com

# certification
CERT_DEPLOY_TOKEN=
CERT_API_URL=https://cert.example.com

# production
PROD_DEPLOY_TOKEN=
PROD_API_URL=https://prod.example.com
